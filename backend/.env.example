# Foja AI - Environment Configuration Example
# Copy this file to .env and adjust variables as needed

APP_NAME="Foja AI"
APP_VERSION="0.1.0"
DEBUG=false

# CORS Origins (comma-separated if JSON array parsed, or defaults to localhost)
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Local Ollama AI
OLLAMA_BASE_URL="http://127.0.0.1:11434"
DEFAULT_OLLAMA_MODEL="llama3.2:1b"
API_TIMEOUT=120.0

# Database URL
# SQLite default: automatically resolves to <project-root>/data/foja.db regardless of working directory
DATABASE_URL="sqlite+aiosqlite:///../data/foja.db"
# PostgreSQL example: postgresql+asyncpg://user:password@localhost:5432/foja_ai

